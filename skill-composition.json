{
  "version": 1,
  "optional_references": [],
  "standalone_scenarios": [
    {
      "id": "japanese-writing-standalone",
      "skill": "japanese-writing-skill",
      "request": "既存の日本語 README の意味、数値、リンクを維持したまま、要点が先に伝わる GFM へ改訂してください。",
      "expected": [
        "与えられた文書だけから必要な文章作業を完了する。",
        "意味と事実関係を維持し、要点を詳細より先に置く。"
      ],
      "forbidden": [
        "別のスキルがないことを理由に文章を完成させない。",
        "依頼されていない意味や事実関係を変更する。"
      ]
    },
    {
      "id": "lean-implementation-standalone",
      "skill": "maintain-lean-implementation",
      "request": "重複した分岐を持つ小さな CLI 実装を、現行仕様を保ったまま整理し、代表経路を確認してください。",
      "expected": [
        "単独で実装を整理し、不要になった重複を残さない。",
        "変更した代表経路を安全に実測して結果を報告する。"
      ],
      "forbidden": [
        "性能計測用の別スキルがないことを理由に実測を省略する。",
        "現行仕様に必要な互換経路を簡潔さだけで削除する。"
      ]
    },
    {
      "id": "lean-tests-standalone",
      "skill": "maintain-lean-tests",
      "request": "同じ挙動を重複して検証するテストを、回帰検出能力を保ったまま整理してください。",
      "expected": [
        "言語固有の別スキルなしでテストと fixture を整理する。",
        "外部挙動の検証と必要な品質ゲートを維持する。"
      ],
      "forbidden": [
        "別のテストスキルがないことを理由に作業を中断する。",
        "テスト数を減らすことだけを目的に回帰検出能力を失う。"
      ]
    },
    {
      "id": "software-specification-standalone",
      "skill": "maintain-software-specifications",
      "request": "既存の正本仕様へ新しい API 要求を追加し、変更対象外の意味と関連仕様との整合性を維持してください。",
      "expected": [
        "別のレビュースキルなしで関連仕様を調査して整合した仕様を完成させる。",
        "必要な要求だけを追加し、未定義の裁量を過剰に埋めない。"
      ],
      "forbidden": [
        "仕様レビュー用の別スキルを必須条件にする。",
        "既存実装だけから新しい正本仕様を推測して追加する。"
      ]
    },
    {
      "id": "runtime-performance-standalone",
      "skill": "measure-runtime-performance",
      "request": "既存の benchmark tool がないローカル CLI の代表経路を計測し、必要なら最小の計測 tool だけを開発依存へ追加して、確認できたボトルネックだけを改善・再計測してください。",
      "expected": [
        "単独で baseline、変更後の時間、計測条件を報告する。",
        "実測で特定した箇所だけを改善する。",
        "既存手段では必要な観測ができない場合だけ、選択した計測 tool を開発依存へ追加する。"
      ],
      "forbidden": [
        "実装保守用の別スキルがないことを理由に確認済みの改善を行わない。",
        "実測していない箇所を推測だけで最適化する。",
        "候補 tool 一式または計測 tool を runtime dependency へ追加する。"
      ]
    },
    {
      "id": "python-development-standalone",
      "skill": "python-dev-skill",
      "request": "既存 benchmark がない Python package の性能回帰を調査して修正し、必要な計測 tool、プロジェクトが定める品質ゲート、代表経路を確認してください。",
      "expected": [
        "単独で Python 構成を調査し、性能回帰の修正、検査、計測を完了する。",
        "プロジェクトが宣言する環境と設定を優先し、計測目的に合う最小の tool を選ぶ。",
        "第三者 tool が必要な場合は開発依存へ追加し、profiler なしの代表経路を再計測する。"
      ],
      "forbidden": [
        "汎用の実装、テスト、性能スキルを完了条件にする。",
        "既存設定を調査せずに一律の厳格設定を強制する。",
        "用途を確認せず候補 tool 一式を追加し、profiler の実行時間を benchmark とする。"
      ]
    },
    {
      "id": "specification-review-standalone",
      "skill": "review-specification-conformance",
      "request": "二つの正本仕様をレビューし、一方に従うと他方へ必ず違反する箇所だけを報告してください。ファイルは変更しないでください。",
      "expected": [
        "単独で正本と優先関係を確認し、具体的な根拠がある所見だけを返す。",
        "レビューだけの依頼ではファイルを変更しない。"
      ],
      "forbidden": [
        "仕様保守用の別スキルがないことを理由にレビューを中断する。",
        "仕様の隙間や好みだけを fatal 所見にする。"
      ]
    },
    {
      "id": "suggest-commit-message-standalone",
      "skill": "suggest-commit-message",
      "request": "$suggest-commit-message",
      "expected": [
        "裸の呼び出しをコミットメッセージの提案依頼として解釈する。",
        "意味論的なセッション文脈がある場合は、その目的と判断を根拠に未コミット変更全体の高レベルな意味を示す。",
        "意味論的なセッション文脈がない場合は、差分から目的を補わず一つの簡潔な質問で確認する。",
        "提案でき、追加指示がない場合は、日本語の一行一案だけをコードブロックで提示する。"
      ],
      "forbidden": [
        "差分から読み取れるファイル名や修正項目をコミットメッセージとして列挙する。",
        "README、コメント、識別子、Git 履歴、Git 差分を、欠けた意味論的なセッション文脈の代わりにする。",
        "別の文章または Git スキルがないことを理由に提案を中断する。"
      ]
    },
    {
      "id": "structured-output-validation-standalone",
      "skill": "validate-openai-structured-output-schema",
      "request": "OpenAI Structured Outputs 用の不正な JSON Schema をオフライン検証し、許可されている場合は最小修正して再検証してください。",
      "expected": [
        "配布 CLI だけで診断、修正、再検証を完了する。",
        "使用したプロファイルと結果を報告する。"
      ],
      "forbidden": [
        "別のレビューまたは Python スキルを必須条件にする。",
        "オフライン検証の成功をリモート受理の保証として報告する。"
      ]
    }
  ],
  "combination_scenarios": [
